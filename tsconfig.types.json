{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist/types",
    "rootDir": "."
  },
  "include": [
    "packages/**/src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/test/**",
    "**/*.test.js"
  ]
}
