{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "packages/**/src/**/*.js",
    "packages/**/test/**/*.js",
    "tests/**/*.js",
    "vitest.config.js"
  ],
  "exclude": [
    "**/dist/**",
    "coverage",
    "dist",
    "node_modules",
    "packages/widget/**",
    "scripts/**"
  ]
}
